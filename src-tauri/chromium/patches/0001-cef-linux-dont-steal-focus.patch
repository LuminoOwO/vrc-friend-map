+/// Whether the X input focus currently sits in a top-level window other than the one
+/// that contains `xid` (another application, or another of our own windows).
+///
+/// `None` / `PointerRoot` focus, or anything that cannot be read, counts as "not
+/// elsewhere", so callers only hold back when another window really has the focus.
+pub(crate) fn input_focus_elsewhere(xid: c_ulong) -> bool {
+  if xid == 0 {
+    return false;
+  }
+  with_x11(false, |xlib, display| unsafe {
+    // The direct child of the root window that holds `w`: the window manager's
+    // frame (or the toplevel itself when it is unframed).
+    let top_of = |mut w: c_ulong| -> Option<c_ulong> {
+      for _ in 0..64 {
+        let (mut root, mut parent, mut kids, mut n) =
+          (0, 0, std::ptr::null_mut::<c_ulong>(), 0u32);
+        if (xlib.XQueryTree)(display, w, &mut root, &mut parent, &mut kids, &mut n) == 0 {
+          return None;
+        }
+        if !kids.is_null() {
+          (xlib.XFree)(kids.cast());
+        }
+        if parent == 0 || parent == root {
+          return Some(w);
+        }
+        w = parent;
+      }
+      None
+    };
+
+    let (mut focus, mut revert) = (0, 0);
+    (xlib.XGetInputFocus)(display, &mut focus, &mut revert);
+    // 0 = None, 1 = PointerRoot.
+    if focus <= 1 || focus == (xlib.XDefaultRootWindow)(display) {
+      return false;
+    }
+    match (top_of(focus), top_of(xid)) {
+      (Some(focused), Some(ours)) => focused != ours,
+      _ => false,
+    }
+  })
+}
+
 pub(super) fn atom(xlib: &xlib::Xlib, display: *mut xlib::Display, name: &str) -> c_ulong {
   let cname = CString::new(name).unwrap();
   unsafe { (xlib.XInternAtom)(display, cname.as_ptr(), 0) }
