+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+use cef::*;
+
+// Keeps CEF from pulling the keyboard focus back while another window has it.
+//
+// On X11 the browser's window is not managed by the window manager, so when CEF
+// focuses the browser (after a navigation, or 100 ms after any `FocusIn` on its
+// host window) Chromium calls `XSetInputFocus` directly with a fresh server
+// timestamp. That bypasses the window manager's focus-stealing prevention: a
+// password manager prompt, or any other window the user just switched to, loses
+// the focus again. Cancel those requests while the input focus belongs to another
+// top-level window; once the user comes back to ours, focusing works as before.
+wrap_focus_handler! {
+  pub struct TauriCefFocusHandler;
+
+  impl FocusHandler {
+    fn on_set_focus(
+      &self,
+      browser: Option<&mut Browser>,
+      _source: FocusSource,
+    ) -> ::std::os::raw::c_int {
+      #[cfg(any(
+        target_os = "linux",
+        target_os = "dragonfly",
+        target_os = "freebsd",
+        target_os = "netbsd",
+        target_os = "openbsd"
+      ))]
+      if std::env::var("VRC_FRIEND_MAP_FOCUS_GUARD").as_deref() == Ok("0") {
+        return 0;
+      }
+      #[cfg(any(
+        target_os = "linux",
+        target_os = "dragonfly",
+        target_os = "freebsd",
+        target_os = "netbsd",
+        target_os = "openbsd"
+      ))]
+      if let Some(host) = browser.and_then(|b| b.host()) {
+        let xid = host.window_handle() as ::std::os::raw::c_ulong;
+        if crate::platform::linux::input_focus_elsewhere(xid) {
+          return 1;
+        }
+      }
+      #[cfg(not(any(
+        target_os = "linux",
+        target_os = "dragonfly",
+        target_os = "freebsd",
+        target_os = "netbsd",
+        target_os = "openbsd"
+      )))]
+      let _ = browser;
+      0
+    }
+  }
+}
