{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app UI. The vrchat.com login window gets no IPC access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "vrchat://*"
        }
      ]
    },
    "notification:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
